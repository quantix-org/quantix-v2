{
  "name": "@quantix/wallet-extension",
  "description": "Quantix browser wallet extension built with WXT",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && node scripts/postbuild-action-icons.mjs",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.6.1",
    "@quantix/wallet-core": "file:../../packages/wallet-core"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "wxt": "^0.20.26"
  }
}
