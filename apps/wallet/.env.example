# Wallet app environment template
# Copy this to apps/wallet/.env.local for local development.

NEXT_PUBLIC_RPC_URL=http://localhost:7330/rpc
# Optional server-side override for API routes.
NODE_RPC_URL=http://localhost:7330/rpc
# Optional chain id used by faucet signing payload.
QTX_CHAIN_ID=quantix-devnet

# Faucet funder wallet (split per field; recommended):
FAUCET_FUNDER_VERSION=quantix-key/v1
FAUCET_FUNDER_ADDRESS=qtx1...
FAUCET_FUNDER_PUBLIC_KEY=...
FAUCET_FUNDER_PRIVATE_KEY=...
FAUCET_FUNDER_SEED=...
FAUCET_FUNDER_CREATED_AT=2026-01-01T00:00:00.000Z

# Optional legacy single-var format as RAW JSON object string:
# FAUCET_FUNDER_WALLET_JSON={"version":"quantix-key/v1","address":"qtx1...","publicKey":"...","privateKey":"...","seed":"...","createdAt":"2026-01-01T00:00:00.000Z"}

# Alternative format (escaped JSON string, often used in .env.local):
# FAUCET_FUNDER_WALLET_JSON="{\"version\":\"quantix-key/v1\",\"address\":\"qtx1...\",\"publicKey\":\"...\",\"privateKey\":\"...\",\"seed\":\"...\",\"createdAt\":\"2026-01-01T00:00:00.000Z\"}"
