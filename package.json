{
  "name": "quantix-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Fresh-code post-quantum blockchain research prototype",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run -ws build",
    "dev:devnet": "tsx tools/devnet/run-3node.ts",
    "dev:devnet4": "tsx tools/devnet/run-4node.ts",
    "dev:node": "npm run -w @quantix/node dev",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "npm run -ws typecheck",
    "lint": "npm run -ws lint",
    "reset": "rm -rf testnets/devnet/data && mkdir -p testnets/devnet/data",
    "explorer": "tsx tools/explorer/explorer.ts",
    "explorer:devnet": "tsx tools/explorer/explorer.ts http://164.68.118.17:7332/rpc 8989",
    "explorer:next": "npm run -w @quantix/explorer dev",
    "explorer:next:build": "npm run -w @quantix/explorer build",
    "explorer:next:typecheck": "npm run -w @quantix/explorer typecheck",
    "qtx": "tsx tools/wallet/qtx.ts",
    "spam-tx": "tsx tools/wallet/spam-tx.ts",
    "wallet": "cd apps/wallet && npm run dev",
    "wallet:build": "npm run -w @quantix/wallet build",
    "wallet:next": "npm run -w @quantix/wallet-next dev",
    "wallet:next:build": "npm run -w @quantix/wallet-next build",
    "wallet:next:typecheck": "npm run -w @quantix/wallet-next typecheck",
    "wallet:ext:build": "npm run -w @quantix/wallet-extension build",
    "wallet:ext:typecheck": "npm run -w @quantix/wallet-extension typecheck"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
